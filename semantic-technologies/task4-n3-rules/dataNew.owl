:andy rdf:type owl:NamedIndividual ,
               ex:LivingPerson ,
               ex:Person ;
      <http://www.co-ode.org/ontologies/ont.owl#hasChild> :bill ,
                                                          :harry ;
      <http://www.co-ode.org/ontologies/ont.owl#hasWife> :alice .


