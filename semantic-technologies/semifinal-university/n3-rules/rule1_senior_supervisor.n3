@prefix : <https://users.jyu.fi/~rhremon/universityOntology.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Rule 1: Senior Supervisor (Transitivity)
# If X is supervised by Y, and Y is supervised by Z,
# then X has a senior supervisor Z.

{
    ?x :supervisedBy ?y .
    ?y :supervisedBy ?z .
}
=>
{
    ?x :hasSeniorSupervisor ?z .
} .
