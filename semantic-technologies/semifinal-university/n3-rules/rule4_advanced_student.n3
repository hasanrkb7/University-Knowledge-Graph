@prefix : <https://users.jyu.fi/~rhremon/universityOntology.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .

# Rule 4: Advanced Student
# If student S has GPA greater than 3.5,
# then student S is an advanced student.

{
    ?student a :Student .
    ?student :hasGPA ?gpa .
    ?gpa math:greaterThan 3.5 .
}
=>
{
    ?student a :AdvancedStudent .
} .
