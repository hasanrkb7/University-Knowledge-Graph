<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>RDF4J SPARQL Endpoint</display-name>
    
    <description>
        RDF4J SPARQL Endpoint Servlet for TIES4520 Semi-Final Assignment
    </description>
    
    <servlet>
        <servlet-name>RDF4JEndpointServlet</servlet-name>
        <servlet-class>com.university.servlet.RDF4JEndpointServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>RDF4JEndpointServlet</servlet-name>
        <url-pattern>/query</url-pattern>
    </servlet-mapping>
    
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    
</web-app>