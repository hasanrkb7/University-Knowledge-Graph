@prefix : <http://www.semanticweb.org/hasan/ontologies/2025/8/untitled-ontology-4/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/hasan/ontologies/2025/8/untitled-ontology-4/> .

<http://www.restaurant.com/ontology#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.restaurant.com/ontology#containsIngredient
:containsIngredient rdf:type owl:ObjectProperty ;
                    rdfs:domain :FoodItem ;
                    rdfs:range :Ingredient .


###  http://www.restaurant.com/ontology#orderedBy
:orderedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :FoodItem ;
           rdfs:range :Customer .


###  http://www.restaurant.com/ontology#preparedBy
:preparedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :FoodItem ;
            rdfs:range :Chef .


###  http://www.restaurant.com/ontology#servedBy
:servedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :FoodItem ;
          rdfs:range :Waiter .


###  http://www.restaurant.com/ontology#serves
:serves rdf:type owl:ObjectProperty ;
        rdfs:domain :Restaurant ;
        rdfs:range :FoodItem .


#################################################################
#    Data properties
#################################################################

###  http://www.restaurant.com/ontology#hasAddress
:hasAddress rdf:type owl:DatatypeProperty ;
            rdfs:domain :Restaurant ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :containsIngredient ;
                          owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                          owl:onClass :Ingredient
                        ] ;
            rdfs:range xsd:string .


###  http://www.restaurant.com/ontology#hasCalories
:hasCalories rdf:type owl:DatatypeProperty ;
             rdfs:domain :FoodItem ;
             rdfs:range xsd:integer .


###  http://www.restaurant.com/ontology#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain :FoodItem ;
         rdfs:range xsd:string .


###  http://www.restaurant.com/ontology#hasPrice
:hasPrice rdf:type owl:DatatypeProperty ;
          rdfs:domain :FoodItem ;
          rdfs:range xsd:float .


###  http://www.restaurant.com/ontology#hasRating
:hasRating rdf:type owl:DatatypeProperty ;
           rdfs:domain :Restaurant ;
           rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  http://www.restaurant.com/ontology#AffordableDish
:AffordableDish rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :FoodItem
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :hasPrice ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:float ;
                                                                                  owl:withRestrictions ( [ xsd:maxExclusive "15.0"^^xsd:float
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#AlcoholicBeverage
:AlcoholicBeverage rdf:type owl:Class ;
                   rdfs:subClassOf :Beverage .


###  http://www.restaurant.com/ontology#Appetizer
:Appetizer rdf:type owl:Class ;
           rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#Beverage
:Beverage rdf:type owl:Class ;
          rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#Chef
:Chef rdf:type owl:Class ;
      rdfs:subClassOf :Person .


###  http://www.restaurant.com/ontology#CompleteMeal
:CompleteMeal rdf:type owl:Class ;
              rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#Customer
:Customer rdf:type owl:Class ;
          rdfs:subClassOf :Person .


###  http://www.restaurant.com/ontology#Dessert
:Dessert rdf:type owl:Class ;
         rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#FastFoodRestaurant
:FastFoodRestaurant rdf:type owl:Class ;
                    rdfs:subClassOf :Restaurant .


###  http://www.restaurant.com/ontology#FineD_iningRestaurant
:FineD_iningRestaurant rdf:type owl:Class ;
                       rdfs:subClassOf :Restaurant .


###  http://www.restaurant.com/ontology#FoodItem
:FoodItem rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :containsIngredient ;
                            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                            owl:onClass :Ingredient
                          ] .


###  http://www.restaurant.com/ontology#HealthyVegetarianOption
:HealthyVegetarianOption rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :VegetarianDish
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasCalories ;
                                                                      owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                           owl:onDatatype xsd:integer ;
                                                                                           owl:withRestrictions ( [ xsd:maxExclusive 500
                                                                                                                  ]
                                                                                                                )
                                                                                         ]
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#Ingredient
:Ingredient rdf:type owl:Class .


###  http://www.restaurant.com/ontology#MainCourse
:MainCourse rdf:type owl:Class ;
            rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#MealType
:MealType rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( :breakfast
                                            :dinner
                                            :lunch
                                          )
                              ] .


###  http://www.restaurant.com/ontology#MeatDish
:MeatDish rdf:type owl:Class ;
          rdfs:subClassOf :MainCourse .


###  http://www.restaurant.com/ontology#MenuSelection
:MenuSelection rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:unionOf ( :Appetizer
                                                   :Dessert
                                                   :MainCourse
                                                 )
                                   ] .


###  http://www.restaurant.com/ontology#NonAlcoholicBeverage
:NonAlcoholicBeverage rdf:type owl:Class ;
                      rdfs:subClassOf :Beverage .


###  http://www.restaurant.com/ontology#NonVegetarianDish
:NonVegetarianDish rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :FoodItem
                                                              [ rdf:type owl:Class ;
                                                                owl:complementOf :VegetarianDish
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf :FoodItem .


###  http://www.restaurant.com/ontology#Person
:Person rdf:type owl:Class .


###  http://www.restaurant.com/ontology#Protein
:Protein rdf:type owl:Class ;
         rdfs:subClassOf :Ingredient .


###  http://www.restaurant.com/ontology#Restaurant
:Restaurant rdf:type owl:Class .


###  http://www.restaurant.com/ontology#Vegetable
:Vegetable rdf:type owl:Class ;
           rdfs:subClassOf :Ingredient .


###  http://www.restaurant.com/ontology#VegetarianDish
:VegetarianDish rdf:type owl:Class ;
                rdfs:subClassOf :MainCourse .


###  http://www.restaurant.com/ontology#Waiter
:Waiter rdf:type owl:Class ;
        rdfs:subClassOf :Person .


#################################################################
#    Individuals
#################################################################

###  http://www.restaurant.com/ontology#breakfast
:breakfast rdf:type owl:NamedIndividual .


###  http://www.restaurant.com/ontology#dinner
:dinner rdf:type owl:NamedIndividual .


###  http://www.restaurant.com/ontology#lunch
:lunch rdf:type owl:NamedIndividual .


